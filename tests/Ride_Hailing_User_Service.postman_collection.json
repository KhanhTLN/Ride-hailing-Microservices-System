{
  "info": {
    "_postman_id": "a8f5b3c4-1234-4567-89ab-cdef01234567",
    "name": "RHDS - Microservices API (User & Driver via gRPC)",
    "description": "Bộ sưu tập API kiểm thử cho User Service (Port 8082) và Driver Service (Port 8081 - kết nối qua gRPC Port 9090)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userBaseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "driverBaseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "sampleUserId",
      "value": "de28a2a8-33b1-4155-bfa1-76136eaece19",
      "type": "string"
    },
    {
      "key": "sampleDriverId",
      "value": "a1111111-2222-3333-4444-555555555555",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Driver Service (gRPC Orchestration)",
      "item": [
        {
          "name": "1.1. Register Driver (Orchestrate User via gRPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"driver_duc_new\",\n  \"password\": \"123456\",\n  \"firstName\": \"Đức\",\n  \"lastName\": \"Trần Văn\",\n  \"phone\": \"0934567891\",\n  \"email\": \"driver.duc.new@gmail.com\",\n  \"identityCard\": \"001202099991\",\n  \"licenseNumber\": \"B2-55667791\",\n  \"vehicleType\": \"CAR_4_SEATS\",\n  \"vehiclePlate\": \"30E-999.91\",\n  \"vehicleModel\": \"Toyota Vios 2024\"\n}"
            },
            "url": {
              "raw": "{{driverBaseUrl}}/api/drivers/register",
              "host": [
                "{{driverBaseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "register"
              ]
            },
            "description": "Đăng ký trọn gói tài xế: driver-service gọi gRPC sang user-service tạo User (role DRIVER), nhận userId và lưu Driver vào rhds-driver."
          },
          "response": []
        },
        {
          "name": "1.2. Get Driver Profile (Queries DriverDB + User info via gRPC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{driverBaseUrl}}/api/drivers/{{sampleDriverId}}",
              "host": [
                "{{driverBaseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{sampleDriverId}}"
              ]
            },
            "description": "Lấy hồ sơ tài xế: Lấy thông tin bằng lái/xe từ driver-service và họ tên/SĐT từ user-service qua gRPC."
          },
          "response": []
        },
        {
          "name": "1.3. Test Duplicate License Plate (Fail 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"driver_fail_plate\",\n  \"password\": \"123456\",\n  \"firstName\": \"Hải\",\n  \"lastName\": \"Lê\",\n  \"phone\": \"0977665544\",\n  \"email\": \"haile@gmail.com\",\n  \"identityCard\": \"001202088888\",\n  \"licenseNumber\": \"B2-88888888\",\n  \"vehicleType\": \"CAR_4_SEATS\",\n  \"vehiclePlate\": \"29A-888.88\",\n  \"vehicleModel\": \"Hyundai Accent\"\n}"
            },
            "url": {
              "raw": "{{driverBaseUrl}}/api/drivers/register",
              "host": [
                "{{driverBaseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "register"
              ]
            },
            "description": "Test lỗi trùng biển số xe (đã có trong seed data: 29A-888.88), driver-service chặn ngay lập tức."
          },
          "response": []
        }
      ]
    },
    {
