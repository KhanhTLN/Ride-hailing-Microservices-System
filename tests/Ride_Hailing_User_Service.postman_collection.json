      "name": "1. Auth - Register Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"nguyenvan_a\",\n  \"firstName\": \"Văn A\",\n  \"lastName\": \"Nguyễn\",\n  \"phone\": \"0912345678\",\n  \"email\": \"nguyenvana@gmail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Đăng ký tài khoản khách hàng mới (Role CUSTOMER, Status INACTIVE)"
      },
      "response": []
    },
    {
      "name": "2. User - Get All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/user",
