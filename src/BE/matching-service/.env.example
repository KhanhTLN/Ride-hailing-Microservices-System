SERVICE_NAME=matching-service
HTTP_HOST=127.0.0.1
HTTP_PORT=8084
DATABASE_URL=postgresql+asyncpg://postgres:replace_me@localhost:5432/matching
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=matching-v1
KAFKA_TRIP_TOPIC=ds03.trip.events.v1
KAFKA_MATCHING_TOPIC=ds03.matching.events.v1
# Driver must implement ds03.driver.v1.DriverService; User's gRPC port 9090 is a different API.
DRIVER_GRPC_ADDRESS=localhost:9091
# Current Java internal gRPC calls have no bearer token. Optional user-service access token
# can be supplied if Driver later validates it. Matching never logs in as a passenger.
DRIVER_GRPC_BEARER_TOKEN=
DRIVER_GRPC_TLS=false
DRIVER_GRPC_CA_FILE=
MATCHING_RADIUS_M=5000
MATCHING_CANDIDATE_LIMIT=20
RESERVATION_HOLD_SECONDS=30
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=30
GRPC_QUERY_TIMEOUT_SECONDS=2
GRPC_MUTATION_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
