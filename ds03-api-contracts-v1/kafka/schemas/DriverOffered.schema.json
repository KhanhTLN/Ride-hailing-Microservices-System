{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriverOffered",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "DriverOffered"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "trip"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "data": {
      "type": "object",
      "properties": {
        "trip_id": {
          "type": "string",
          "format": "uuid"
        },
        "passenger_id": {
          "type": "string",
          "format": "uuid"
        },
        "driver_id": {
          "type": "string",
          "format": "uuid"
        },
        "driver_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "SEARCHING",
            "DRIVER_OFFERED",
            "ACCEPTED",
            "ARRIVED",
            "IN_PROGRESS",
            "COMPLETED",
            "CANCELLED",
            "NO_DRIVER"
          ]
        },
        "trip_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "reservation_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "pickup": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "address": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        "dropoff": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "address": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        "estimated_fare": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "currency": {
              "type": "string",
              "enum": [
                "VND"
              ]
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "trip_id",
        "passenger_id",
        "driver_id",
        "driver_user_id",
        "status",
        "trip_version",
        "attempt_id",
        "reservation_id",
        "expires_at",
        "pickup",
        "dropoff",
        "estimated_fare"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "producer",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "aggregate_id",
    "aggregate_version",
    "data"
  ],
  "additionalProperties": false
}
