{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentSucceeded",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "PaymentSucceeded"
    },
    "schema_version": {
      "const": 1
    },
    "producer": {
      "const": "payment"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "data": {
      "type": "object",
      "properties": {
        "trip_id": {
          "type": "string",
          "format": "uuid"
        },
        "passenger_id": {
          "type": "string",
          "format": "uuid"
        },
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "amount": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "currency": {
              "type": "string",
              "enum": [
                "VND"
              ]
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "trip_id",
        "passenger_id",
        "payment_id",
        "attempt_number",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "producer",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "aggregate_id",
    "aggregate_version",
    "data"
  ],
  "additionalProperties": false
}
