        {
          "name": "2.4. Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer_an_new\",\n  \"firstName\": \"An Khang\",\n  \"lastName\": \"Nguyễn\",\n  \"phone\": \"0911223399\",\n  \"email\": \"an.new@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{userBaseUrl}}/api/user/{{sampleUserId}}",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "user", "{{sampleUserId}}"]
            },
            "description": "Cập nhật thông tin profile của người dùng"
          },
          "response": []
        },
        {
          "name": "2.5. Delete User By ID",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{userBaseUrl}}/api/user/{{sampleUserId}}",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "user", "{{sampleUserId}}"]
            },
            "description": "Xóa tài khoản người dùng theo UUID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Driver Service (Port 8081 - gRPC Port 9090)",
      "item": [
        {
          "name": "3.1. Register Driver - Car 4 Seats (gRPC Orchestration)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.userId) {",
                  "    pm.collectionVariables.set(\"sampleDriverId\", jsonData.data.userId);",
                  "    console.log(\"Saved sampleDriverId:\", jsonData.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"driver_duc_new\",\n  \"password\": \"password123\",\n  \"firstName\": \"Đức\",\n  \"lastName\": \"Trần Văn\",\n  \"phone\": \"0934567891\",\n  \"email\": \"driver.duc.new@gmail.com\",\n  \"identityCard\": \"001202099991\",\n  \"licenseNumber\": \"B2-55667791\",\n  \"vehicleType\": \"CAR_4_SEATS\",\n  \"vehiclePlate\": \"30E-999.91\",\n  \"vehicleModel\": \"Toyota Vios 2024\"\n}"
