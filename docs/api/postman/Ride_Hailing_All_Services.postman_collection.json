      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication Service (Port 8082)",
      "item": [
        {
          "name": "1.1. Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer_an\",\n  \"firstName\": \"An\",\n  \"lastName\": \"Nguyễn\",\n  \"phone\": \"0911223344\",\n  \"email\": \"customer.an@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{userBaseUrl}}/api/auth/register/customer",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "auth", "register", "customer"]
            },
            "description": "Đăng ký tài khoản khách hàng thông thường (role CUSTOMER)"
          },
          "response": []
        },
        {
          "name": "1.2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "    console.log(\"Saved accessToken:\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer_an\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{userBaseUrl}}/api/auth/login",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập hệ thống, nhận Access Token trong Body (tự động gán vào biến accessToken) và Refresh Token trong Cookie"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. User Management Service (Port 8082)",
      "item": [
        {
          "name": "2.1. Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{userBaseUrl}}/api/user",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "user"]
            },
            "description": "Lấy danh sách tất cả người dùng trong hệ thống"
          },
          "response": []
        },
        {
          "name": "2.2. Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{userBaseUrl}}/api/user/{{sampleUserId}}",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "user", "{{sampleUserId}}"]
            },
            "description": "Lấy thông tin chi tiết một người dùng theo UUID"
          },
          "response": []
        },
        {
