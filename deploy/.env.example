# Optional overrides for deploy/docker-compose.yml. Copy to deploy/.env.
# These are development credentials, unrelated to the src/BE/*/.env files.
PRICING_DB_PASSWORD=pricing_local
USER_DB_PASSWORD=user_local
DRIVER_DB_PASSWORD=driver_local
TRIP_DB_PASSWORD=trip_local
# Use URL-safe characters: this password is embedded in a SQLAlchemy URL.
MATCHING_DB_PASSWORD=matching_local
JWT_SECRET=local-development-shared-jwt-secret-change-me-0123456789-abcdefghij

USER_HTTP_PORT=8082
FE_HTTP_PORT=5173
DRIVER_HTTP_PORT=8081
TRIP_HTTP_PORT=8080
PRICING_HTTP_PORT=8083
MATCHING_HTTP_PORT=8084
USER_GRPC_PORT=9090
DRIVER_GRPC_PORT=9091
PRICING_GRPC_PORT=9093
PRICING_DB_PORT=5436
USER_DB_PORT=5435
DRIVER_DB_PORT=5433
TRIP_DB_PORT=5434
MATCHING_DB_PORT=5544
KAFKA_PORT=9092
REDIS_PORT=6379

# Maps: public/demo providers (network required), no API keys.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Search-as-you-type uses Photon; public Nominatim forbids autocomplete.
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_COUNTRY_CODES=vn
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MOTORBIKE_BASE_URL=https://router.project-osrm.org
OSRM_CAR_PROFILE=driving
OSRM_MOTORBIKE_PROFILE=driving
# Public demo uses the car graph for both vehicle types; NOT a dedicated motorcycle model.
OSRM_MOTORBIKE_USES_DRIVING_MODEL=true
# Set an identifying app name and contact URL/email for your deployed app.
MAPS_USER_AGENT=RideHailingMicroservicesCourse/1.0
MAPS_AUTH_BASE_URL=http://localhost:8082
